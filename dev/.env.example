# Copy to .env and set your own passwords.

# Nextcloud major version: 33, 34 or 35 (fresh volumes needed when switching back to an older one)
NC_VERSION=35
NC_PORT=8090
# space-separated host names/IPs under which you open the instance
NC_TRUSTED_DOMAINS=ds925p 192.168.1.122

DB_PASSWORD=change-me
# same password policy as above
NC_ADMIN_PASSWORD=change-me
# password for the test users "frank" and "kind"
# min. 10 characters and not in known password leaks (Nextcloud password policy)
DEV_USER_PASSWORD=change-me
