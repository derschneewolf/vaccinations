<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>vaccinations</id>
    <name>Vaccinations</name>
    <summary>Track vaccinations of your Nextcloud users and check them against a vaccination schedule</summary>
    <description><![CDATA[Record vaccinations (date, vaccine, optional practice) for every user and check them against a selectable vaccination schedule (initially the German STIKO schedule). Shows overdue and upcoming vaccinations.

The vaccine-to-disease mapping is maintained as open data in the repository and can be extended via pull request.]]></description>
    <version>0.5.1</version>
    <licence>agpl</licence>
    <author>Frank</author>
    <namespace>Vaccinations</namespace>
    <category>organization</category>
    <bugs>https://github.com/derschneewolf/vaccinations/issues</bugs>
    <repository type="git">https://github.com/derschneewolf/vaccinations</repository>
    <dependencies>
        <!-- NC 35 requires PHP >= 8.3, NC 33/34 still support 8.2 -->
        <php min-version="8.2"/>
        <!-- only currently supported majors; raise min-version when a major reaches EOL (NC 33: 2027-02) -->
        <nextcloud min-version="33" max-version="35"/>
    </dependencies>
    <background-jobs>
        <job>OCA\Vaccinations\BackgroundJob\DailyCheck</job>
    </background-jobs>
    <commands>
        <command>OCA\Vaccinations\Command\GuardianAdd</command>
        <command>OCA\Vaccinations\Command\GuardianList</command>
        <command>OCA\Vaccinations\Command\GuardianRemove</command>
        <command>OCA\Vaccinations\Command\Notify</command>
    </commands>
    <navigations>
        <navigation>
            <name>Vaccinations</name>
            <route>vaccinations.page.index</route>
            <icon>app.svg</icon>
        </navigation>
    </navigations>
</info>
