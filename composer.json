{
  "name": "derschneewolf/vaccinations",
  "description": "Nextcloud app to track vaccinations against a vaccination schedule",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "autoload": {
    "psr-4": {
      "OCA\\Vaccinations\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\Vaccinations\\Tests\\": "tests/",
      "OCP\\": "vendor/nextcloud/ocp/OCP/",
      "NCU\\": "vendor/nextcloud/ocp/NCU/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "nextcloud/coding-standard": "^1.3",
    "nextcloud/ocp": "dev-stable33",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/console": "^6.4"
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "lint": "find lib tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "test:unit": "phpunit -c tests/phpunit.xml"
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
