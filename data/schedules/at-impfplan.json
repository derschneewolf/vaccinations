{
  "$schema": "../schema/schedule.schema.json",
  "id": "at-impfplan",
  "name": { "de": "Impfplan Österreich", "en": "Austrian vaccination plan" },
  "version": "2026/27 (Version 1.1)",
  "scope": "Allgemein empfohlene Impfungen für alle Altersgruppen, unabhängig davon, ob sie im kostenfreien Impfprogramm enthalten sind. Indikations-, Berufs- und Reiseimpfungen sind nicht enthalten.",
  "simplifications": [
    "Nachholschemata bei spätem Beginn sind vereinfacht abgebildet; maßgeblich ist die ärztliche Beurteilung.",
    "Rotaviren: unabhängig vom Impfstoff 2 Dosen bis zur 32. Lebenswoche (Rotarix: 2 Dosen bis 24 Wochen, RotaTeq: 3 Dosen bis 32 Wochen).",
    "FSME: Schnellschemata und die je nach Impfstoff unterschiedlichen Abstände der 3. Dosis (FSME-Immun 5–12, Encepur 9–12 Monate) werden nicht unterschieden.",
    "Influenza: Kinder, die zum ersten Mal geimpft werden, brauchen 2 Dosen – das wird nicht geprüft.",
    "COVID-19: Die Auffrischung wird allen ab 12 angeboten; geprüft wird nur die vorrangige Empfehlung ab 60.",
    "Masern-Mumps-Röteln: In jedem Alter nachholbar; Personen ohne dokumentierte Impfung erscheinen als „nicht dokumentiert“.",
    "Einige Angaben stammen aus Sekundärquellen und sind in docs/IMPFPLAN-AT-REGELN.md als „zu prüfen“ markiert."
  ],
  "sources": [
    "https://www.sozialministerium.gv.at/Themen/Gesundheit/Impfen/impfplan.html",
    "https://broschuerenservice.sozialministerium.gv.at/Home/Download?publicationId=420&attachmentName=Impfplan_Oesterreich_2026_2027.pdf",
    "https://www.news.at/technik/neuer-impfplan-keuchhusten-auffrischung-wieder-alle-zehn-jahre",
    "https://kinderarzt.net/impfplan-2018-saeuglinge-und-kleinkinder/",
    "https://kinderarzt.net/impfplan-2018-schulkinder/"
  ],
  "rules": [
    {
      "id": "tdap",
      "diseases": ["diphtheria", "tetanus", "pertussis"],
      "kind": "series",
      "until": "P18Y",
      "reference": "Impfplan 2026/27, Kap. Diphtherie: 2+1-Schema (3. Lebensmonat, +2 Mon., 10–12 Mon.), Auffrischung im 6. Lebensjahr und 5 Jahre später (spätestens 14–15 J.), danach Tdap alle 10 Jahre, ab 60 alle 5 Jahre",
      "variants": [
        {
          "fromAge": "P0D",
          "doses": [
            { "label": "G1", "age": "P2M", "dueUntil": "P4M" },
            { "label": "G2", "age": "P4M", "minInterval": "P8W" },
            { "label": "G3", "age": "P10M", "minInterval": "P6M", "dueUntil": "P13M" },
            { "label": "A1", "age": "P5Y", "dueUntil": "P7Y", "earliestAge": "P4Y" },
            { "label": "A2", "age": "P10Y", "minInterval": "P5Y", "dueUntil": "P15Y", "earliestAge": "P9Y" }
          ]
        },
        {
          "fromAge": "P12M",
          "doses": [
            { "label": "G1", "age": "P0D" },
            { "label": "G2", "age": "P0D", "minInterval": "P4W" },
            { "label": "G3", "age": "P0D", "minInterval": "P6M" }
          ]
        }
      ],
      "then": { "every": "P10Y", "grace": "P12M", "later": { "fromAge": "P60Y", "every": "P5Y" } }
    },
    {
